# Adresse publique du site, utilisée pour les URL canoniques, le sitemap,
# les images de partage et les données structurées.
# À définir sur l'hébergement (préproduction comprise).
NEXT_PUBLIC_SITE_URL=https://yurday.fr

# ID du conteneur Google Tag Manager (ex. GTM-XXXXXXX), qui doit lui-même
# contenir le pixel Meta et tout autre tag de suivi. Laissée vide, aucun
# script de tracking ne se charge (voir src/lib/analytics.ts).
NEXT_PUBLIC_GTM_ID=
